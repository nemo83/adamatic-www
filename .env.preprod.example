# Preprod (testnet) config — copy to .env for a testnet local run.
#
#   cp .env.preprod.example .env
#   npm run dev

# --- Client-side (bundled, visible in the browser) ---
NEXT_PUBLIC_CARDANO_NETWORK_ID="0"
NEXT_PUBLIC_CARDANO_NETWORK=preprod
NEXT_PUBLIC_ADAMATIC_API_URL=http://localhost:8080
NEXT_PUBLIC_BLOCKFROST_API_KEY=preprodXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Opt into the Evolution SDK adapter (leave unset to use Mesh, the default).
# NEXT_PUBLIC_CHAIN_ADAPTER=evolution

# --- Server-side (if/when a Next API route or backend reads these) ---
BLOCKFROST_API_KEY=preprodXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
BLOCKFROST_BASE_URL=https://cardano-preprod.blockfrost.io/api/v0
PUBLIC_NETWORK=0
