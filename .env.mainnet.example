# Mainnet config — copy to .env for a mainnet local run.
#
#   cp .env.mainnet.example .env
#   npm run dev
#
# Warning: transactions submitted with this config spend real ADA.

# --- Client-side (bundled, visible in the browser) ---
NEXT_PUBLIC_CARDANO_NETWORK_ID="1"
NEXT_PUBLIC_CARDANO_NETWORK=mainnet
NEXT_PUBLIC_ADAMATIC_API_URL=http://localhost:8080
NEXT_PUBLIC_BLOCKFROST_API_KEY=mainnetXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Server-side (legacy; carried for any backend code that may consume them) ---
BLOCKFROST_API_KEY=mainnetXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
BLOCKFROST_BASE_URL=https://cardano-mainnet.blockfrost.io/api/v0
PUBLIC_NETWORK=1
